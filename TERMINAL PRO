<!DOCTYPE html>
<html>
<head>
  <title>⚡ Trading Terminal PRO+</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <style>
    body {
      margin: 0;
      font-family: Arial;
      background: #0b1220;
      color: white;
      display: flex;
    }

    .sidebar {
      width: 250px;
      background: #111827;
      padding: 10px;
      height: 100vh;
      overflow-y: auto;
    }

    .btn {
      display: block;
      padding: 8px;
      margin: 5px 0;
      background: #1f2937;
      border-radius: 6px;
      text-align: center;
      cursor: pointer;
    }

    .btn:hover {
      background: #22c55e;
      color: black;
    }

    .main {
      flex: 1;
      padding: 10px;
    }

    textarea {
      width: 100%;
      height: 80px;
      border-radius: 8px;
      padding: 8px;
      border: none;
    }

    .action {
      margin-top: 5px;
      padding: 10px;
      background: #22c55e;
      border-radius: 8px;
      text-align: center;
      cursor: pointer;
      color: black;
      font-weight: bold;
    }

    iframe {
      width: 100%;
      height: 400px;
      border-radius: 10px;
      border: none;
    }

    .watchlist {
      margin-top: 10px;
      background: #111827;
      padding: 10px;
      border-radius: 10px;
    }

    .stock {
      padding: 6px;
      cursor: pointer;
    }

    .stock:hover {
      color: #22c55e;
    }
  </style>
</head>

<body>

<!-- SIDEBAR -->
<div class="sidebar">
  <div class="btn" onclick="openScan('https://chartink.com/screener/early-stage-9')">Early Stage</div>
  <div class="btn" onclick="openScan('https://chartink.com/screener/sweet-spot-38')">A+ Trigger</div>
</div>

<!-- MAIN -->
<div class="main">

  <h3>📥 Paste Chartink Stocks</h3>

  <textarea id="inputBox" placeholder="Paste symbols here (e.g. RELIANCE, TCS, INFY)"></textarea>
  <div class="action" onclick="importStocks()">Import</div>

  <!-- CHART -->
  <iframe id="chartFrame"
    src="https://s.tradingview.com/widgetembed/?symbol=NSE:NIFTY&interval=15&theme=dark">
  </iframe>

  <!-- WATCHLIST -->
  <div class="watchlist">
    <h3>🔥 Auto Watchlist</h3>
    <div id="stockList"></div>
  </div>

</div>

<script>

function openScan(link) {
  window.open(link, "_blank");
}

function loadChart(symbol) {
  document.getElementById("chartFrame").src =
    "https://s.tradingview.com/widgetembed/?symbol=NSE:" + symbol + "&interval=15&theme=dark";
}

function importStocks() {
  let input = document.getElementById("inputBox").value;

  // Clean input
  let stocks = input
    .replace(/\n/g, ",")
    .split(",")
    .map(s => s.trim().toUpperCase())
    .filter(s => s.length > 0);

  let listHTML = "";

  stocks.forEach(stock => {
    listHTML += `<div class="stock" onclick="loadChart('${stock}')">${stock}</div>`;
  });

  document.getElementById("stockList").innerHTML = listHTML;

  if (stocks.length > 0) {
    loadChart(stocks[0]); // auto load first stock
  }
}

</script>

</body>
</html>
